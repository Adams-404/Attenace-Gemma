# Active AI Provider: "api" (Google AI Studio / Gemini API) or "local" (Ollama)
PROVIDER="api"

# GEMINI_API_KEY: Required when PROVIDER="api".
# In Google AI Studio, this is injected automatically from Secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Official Gemma 4 model ID on Google AI Studio (Gemini API):
# Options: "gemma-4-26b-a4b-it" (26B MoE, fast & recommended) or "gemma-4-31b-it" (31B Dense)
GEMINI_MODEL="gemma-4-26b-a4b-it"

# Local Ollama settings (used when PROVIDER="local")
# Default Ollama server URL is http://localhost:11434
# Official Ollama Gemma 4 tags: "gemma4:e2b" (default), "gemma4:e4b", "gemma4:26b", "gemma4:31b"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:e2b"

# Optional server port
PORT="3000"
